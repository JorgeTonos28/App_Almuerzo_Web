{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Database": {
    "Provider": "SqlServer"
  },
  "Operations": {
    "Enabled": false,
    "ScheduledJobsEnabled": false
  },
  "Ad": {
    "Enabled": false,
    "Endpoint": "https://ona-dis-2.infotep.gov.do/InfotepADWebservice/ADService.asmx",
    "DirectoryDomain": "INFOTEP",
    "TimeoutSeconds": 15,
    "FullNameColumn": "NombreCompleto",
    "EmployeeCodeColumn": "CodigoEmpleado",
    "AutoProvisioningEnabled": false,
    "RegionCodeColumn": "",
    "DepartmentCodeColumn": "",
    "DepartmentNameColumn": "",
    "OrganizationContract": "NamesV1",
    "AutoCreateOrganizationEnabled": false
  },
  "Mail": {
    "Mode": "Pickup",
    "AllowSmtpInDevelopment": false,
    "AllowSendGridInDevelopment": false,
    "Port": 587
  },
  "SendGrid": {
    "DataResidency": "Global"
  }
}
