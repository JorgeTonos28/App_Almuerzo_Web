{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Database": { "Provider": "SqlServer" },
  "Operations": { "Enabled": false, "ScheduledJobsEnabled": false },
  "Ad": {
    "Enabled": false,
    "Endpoint": "https://ona-app-01.infotep.gob.do:8005/ADService.asmx",
    "DirectoryDomain": "INFOTEP",
    "TimeoutSeconds": 15,
    "FullNameColumn": "NombreCompleto",
    "EmployeeCodeColumn": "Codigo",
