    "RegionCodeColumn": "",
    "DepartmentCodeColumn": "",
    "DepartmentNameColumn": ""
  },
  "Mail": { "Mode": "Pickup", "AllowSmtpInDevelopment": false, "AllowSendGridInDevelopment": false, "Port": 587 },
  "SendGrid": { "DataResidency": "Global" }
}
