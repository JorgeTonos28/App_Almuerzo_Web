@model Almuerzo.Web.Services.BrandingSettings
<footer class="w-full max-w-md grid grid-cols-[1fr_auto] items-center gap-3 text-xs text-gray-400">
    <p class="break-words">@Model.FooterText</p>
    @if (Model.FooterSignatureUrl.Length > 0) { <img src="@Model.FooterSignatureUrl" alt="Sello institucional" class="h-10 max-w-36 object-contain justify-self-end opacity-60"> }
</footer>
